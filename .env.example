# Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# 텔레그램 봇 토큰 (@BotFather에서 발급)
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 텔레그램 채팅 ID (아래 발급 방법 참고)
TELEGRAM_CHAT_ID=123456789

# Notion 연동 (퀴즈 기록 저장, 선택사항)
NOTION_TOKEN=your-notion-integration-token
NOTION_QUIZ_DB_ID=your-notion-quiz-db-id
